{
    "headers": [
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/(sw.js|service-worker.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
          }
        ]
      }
    ],
      "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/produto", "destination": "/produto.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/depoimentos", "destination": "/depoimentos.html" },
    { "source": "/contto", "destination": "/contato.html" },
    { "source": "/ondeencontrar", "destination": "/ondeencontrar.html" },
    { "source": "/onde", "destination": "/ondeencontrar.html" },
    { "source": "/lojas", "destination": "/todas-as-lojas.html" }
  ]
}